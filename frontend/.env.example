# Backend Toggle
# Set to 'nodejs' to use the local Express/Socket.io backend
# Set to 'supabase' to use Supabase Realtime for serverless peer-to-peer matchmaking
# VITE_BACKEND_TYPE=nodejs
VITE_BACKEND_TYPE=supabase

# Supabase Configuration (Required if VITE_BACKEND_TYPE=supabase)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=